# Copy to .env (project root) or server/.env.local. Both are git-ignored; never commit them.
# Run the OTP server with: npm run otp      and the app with: npm run dev

# Which SMS provider sends the codes: textbee (free) or twilio (paid)
OTP_PROVIDER=textbee

# --- textbee (free: 50 SMS/day, 300/month) ---
# textbee dashboard → API key. The textbee app on your Android phone sends the SMS from its SIM.
TEXTBEE_API_KEY=
# Optional: which phone to send from (GET https://api.textbee.dev/api/v1/gateway/devices → _id). Leave empty for the default.
TEXTBEE_DEVICE_ID=

# --- twilio (paid) ---
# TWILIO_VERIFY_SID=VA...
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...

# The app (Vite) reads this one: points sign-in at the OTP server.
VITE_OTP_API=http://localhost:8787
# Where the app runs (comma-separated)
ALLOW_ORIGIN=http://localhost:5173,http://localhost:5174
